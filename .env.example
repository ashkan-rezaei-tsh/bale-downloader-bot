# Bale Bot API Configuration
# Get your token from @botfather on Bale Messenger
BALE_BOT_TOKEN=your_bale_bot_token_here

# Directory on the server where downloaded videos and files are located
# On Windows, use double backslashes or forward slashes, e.g., e:/downloads or e:\\downloads
DOWNLOADS_DIR=./downloads

# Default Chat or Channel ID where files will be sent (can be a user chat ID or group/channel ID)
DEFAULT_CHAT_ID=

# Comma-separated list of Bale Chat IDs allowed to interact with the bot
# Leave empty to allow any chat (not recommended for production)
ALLOWED_CHAT_IDS=

# Web Dashboard Configuration
PORT=3000
DASHBOARD_PASSWORD=admin

# Comma-separated list of filenames inside downloads directory to hide/ignore in lists
IGNORE_FILES=cookies.txt,yt-dlp.conf,yt-dlp_linux

# Max upload chunk size limit in megabytes (typically 19MB to fit within Bale's 20MB limit)
UPLOAD_MAX_SIZE_MB=19

# Token lifespan for signed temporary download links (e.g. 15m, 1h, 24h)
DOWNLOAD_LINK_EXPIRY=1h

